<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared look for the 今日课程 widget rows. RemoteViews only supports a subset of
         attributes, so each row keeps to layout/background/colour/text size. -->
    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="WidgetBar">
        <item name="android:layout_width">3dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">#5B8DEF</item>
    </style>

    <style name="WidgetRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="WidgetName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#1F2126</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetMeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#6B7280</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WidgetTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">#6B7280</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
